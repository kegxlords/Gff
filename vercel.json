{
  "version": 2,
  "outputDirectory": ".",
  "crons": [
    {
      "path": "/api/admin/daily-income",
      "schedule": "0 23 * * *"
    }
  ],
  "rewrites": [
    { "source": "/login", "destination": "/index.html" },
    { "source": "/register", "destination": "/register.html" },
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/change-password", "destination": "/change-password.html" },
    { "source": "/bank", "destination": "/bank.html" },
    { "source": "/recharge", "destination": "/recharge.html" },
    { "source": "/withdraw", "destination": "/withdraw.html" },
    { "source": "/gift-code", "destination": "/gift-code.html" },
    { "source": "/refer", "destination": "/refer.html" },
    { "source": "/team", "destination": "/team.html" },
    { "source": "/investment", "destination": "/investment.html" },
    { "source": "/VIP", "destination": "/VIP.html" },
    { "source": "/transaction-history", "destination": "/transaction-history.html" },
    { "source": "/messages", "destination": "/messages.html" },
    { "source": "/admin", "destination": "/admin/dashboard.html" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard.html" },
    { "source": "/admin/deposits", "destination": "/admin/deposits.html" },
    { "source": "/admin/withdrawals", "destination": "/admin/withdrawals.html" },
    { "source": "/admin/users", "destination": "/admin/users.html" },
    { "source": "/admin/investments", "destination": "/admin/investments.html" },
    { "source": "/admin/messages", "destination": "/admin/messages.html" },
    { "source": "/admin/settings", "destination": "/admin/settings.html" },
    { "source": "/support", "destination": "/support.html" },
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
